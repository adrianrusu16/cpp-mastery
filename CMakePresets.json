{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 31,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Development (Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "ON",
        "CPP_MASTERY_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "sanitize",
      "displayName": "Development + sanitizers",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/sanitize",
      "cacheVariables": {
        "CPP_MASTERY_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON",
        "CPP_MASTERY_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "gcc16",
      "displayName": "GCC 16 (Debug)",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/gcc16",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "gcc16-sanitize",
      "displayName": "GCC 16 (ASan/UBSan)",
      "inherits": "gcc16",
      "binaryDir": "${sourceDir}/build/gcc16-sanitize",
      "cacheVariables": {
        "CPP_MASTERY_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "clang23",
      "displayName": "Clang 23 (Debug)",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/clang23",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "clang23-sanitize",
      "displayName": "Clang 23 (ASan/UBSan)",
      "inherits": "clang23",
      "binaryDir": "${sourceDir}/build/clang23-sanitize",
      "cacheVariables": {
        "CPP_MASTERY_ENABLE_SANITIZERS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "sanitize",
      "configurePreset": "sanitize"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "gcc16",
      "configurePreset": "gcc16"
    },
    {
      "name": "gcc16-sanitize",
      "configurePreset": "gcc16-sanitize"
    },
    {
      "name": "clang23",
      "configurePreset": "clang23"
    },
    {
      "name": "clang23-sanitize",
      "configurePreset": "clang23-sanitize"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "sanitize",
      "configurePreset": "sanitize",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "gcc16",
      "configurePreset": "gcc16",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "gcc16-sanitize",
      "configurePreset": "gcc16-sanitize",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "clang23",
      "configurePreset": "clang23",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "clang23-sanitize",
      "configurePreset": "clang23-sanitize",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
